#!/bin/sh
# Mount every USB / extra disk partition read-only under /media so flashsh can find SWFs.
for dev in /dev/sd[a-z][0-9]* /dev/sd[a-z] /dev/mmcblk[0-9]p[0-9]* /dev/vd[a-z][0-9]* /dev/vd[a-z]; do
    [ -b "$dev" ] || continue
    name=$(basename "$dev")
    mnt=/media/$name
    grep -q " $mnt " /proc/mounts && continue
    mkdir -p "$mnt"
    mount -o ro "$dev" "$mnt" 2>/dev/null || rmdir "$mnt"
done
