#!/bin/sh
# flash-run FILE.swf -- start X, play the SWF fullscreen in Ruffle, return to tty1.
. /etc/flashos.conf

SWF="$1"
case "$SWF" in
    *.swf|*.SWF) ;;
    *) echo "flash-run: only .swf files are allowed" >&2; exit 2 ;;
esac
[ -r "$SWF" ] || { echo "flash-run: $SWF not found" >&2; exit 2; }

export HOME=/root
export XDG_RUNTIME_DIR=/run/flashos
mkdir -p "$XDG_RUNTIME_DIR" /tmp/.X11-unix
chmod 700 "$XDG_RUNTIME_DIR"
rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock "$XDG_RUNTIME_DIR/user-quit"

Xorg :0 vt2 -nolisten tcp -quiet >/tmp/xorg.log 2>&1 &
XPID=$!

i=0
while [ ! -S /tmp/.X11-unix/X0 ] && [ $i -lt 100 ]; do
    sleep 0.1 2>/dev/null || sleep 1
    i=$((i + 1))
done
if [ ! -S /tmp/.X11-unix/X0 ]; then
    echo "flash-run: X server did not start (see /tmp/xorg.log)" >&2
    kill $XPID 2>/dev/null
    chvt 1
    exit 1
fi

export DISPLAY=:0
flashwm >/tmp/flashwm.log 2>&1 &
WMPID=$!

# shellcheck disable=SC2086
$RUFFLE $RUFFLE_ARGS "$SWF" >/tmp/ruffle.log 2>&1
RC=$?

kill $WMPID 2>/dev/null
kill $XPID 2>/dev/null
wait $XPID 2>/dev/null
chvt 1 2>/dev/null
# Leaving with F12 / Ctrl+Q is a normal exit, not an error
[ -e "$XDG_RUNTIME_DIR/user-quit" ] && RC=0
exit $RC
